# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================
# 📦 DEPENDENCIES
# ==========================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================
# 🧪 TESTING & COVERAGE
# ==========================
/coverage

# ==========================
# ⚙️ NEXT.JS BUILD OUTPUT
# ==========================
/.next/
/out/
/.next/cache/
.turbo/

# ==========================
# 🏗️ PRODUCTION BUILD
# ==========================
/build
/dist

# ==========================
# 🔒 ENVIRONMENT VARIABLES
# ==========================
# Never commit local or sensitive keys (Formspree, API keys, etc.)
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# ==========================
# 🪄 MISCELLANEOUS
# ==========================
.DS_Store
Thumbs.db
*.pem

# ==========================
# 🧠 LOGS
# ==========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# 🖥️ EDITOR / IDE
# ==========================
.vscode/
.idea/
*.swp

# ==========================
# ☁️ DEPLOYMENT
# ==========================
.vercel
.firebase/
.amplify/

# ==========================
# 🧱 OPTIONAL TOOLS
# ==========================
storybook-static/
